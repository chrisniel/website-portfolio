# Normalize source and documentation text files.
* text=auto eol=lf

# Large editable 3D source files.
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text

# Large editable/source video formats.
*.mov filter=lfs diff=lfs merge=lfs -text

# Web-ready assets remain in normal Git storage because Git LFS files are not served by GitHub Pages.
*.glb -text
*.mp4 -text
*.webm -text
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.avif -text

# Layered creative source files and Unity export packages.
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
